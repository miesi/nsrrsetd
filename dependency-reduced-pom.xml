<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>de.mieslinger</groupId>
  <artifactId>nsrrsetd</artifactId>
  <name>NS RRset Daemon</name>
  <version>2.2</version>
  <description>Inspired by DNS Standheizung, this is a combined daemon to
        - warm up the cache of the configured resolver with all delegations found in the root-zone
        - query all Nameserver IPs of the root-zone directly and record query-time (can be disabled)
        - start a jetty to display contents of the Cache containing tld, IP and latency (can be disabled)
        - JSON REST API to get the delegating NS RRSet of a second level zone

        Notes
        - third level domains like .co.uk are correctly handled
        - third level domains like de.com are NOT correctly handled</description>
  <organization>
    <name>IONOS SE</name>
    <url>https://www.ionos.com/</url>
  </organization>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.9.0</version>
        <executions>
          <execution>
            <id>unpack-dependency-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <configuration>
              <classifier>sources</classifier>
              <failOnMissingClassifierArtifact>false</failOnMissingClassifierArtifact>
              <outputDirectory>${project.build.directory}/dependency-sources</outputDirectory>
              <includeArtifactIds>gson</includeArtifactIds>
              <excludes>**/module-info.java,**/package-info.java,META-INF/**</excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-dependency-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.build.directory}/dependency-sources</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>jar-with-dependencies</shadedClassifierName>
              <transformers>
                <transformer>
                  <mainClass>de.mieslinger.nsrrsetd.Main</mainClass>
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
                <transformer />
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <showDeprecation>true</showDeprecation>
          <release>25</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>de.dentrassi.maven</groupId>
        <artifactId>rpm</artifactId>
        <version>1.5.0</version>
        <executions>
          <execution>
            <goals>
              <goal>rpm</goal>
            </goals>
            <configuration>
              <skipSigning>true</skipSigning>
              <attach>false</attach>
              <license>MIT</license>
              <distribution>No</distribution>
              <group>Application/Collectors</group>
              <packager>thomas.mieslinger@ionos.com</packager>
              <prefix>/opt/nsrrsetd</prefix>
              <requires>
                <require>java-headless &gt;= 25</require>
                <require>systemd</require>
              </requires>
              <preinstallScriptlet>
                <script># Create nsrrsetd user if it doesn't exist
if ! getent passwd nsrrsetd &gt;/dev/null; then
    useradd -r -s /bin/false -d /var/lib/nsrrsetd -c "NS RRSet Daemon" nsrrsetd
fi

# Create working directory
if [ ! -d /var/lib/nsrrsetd ]; then
    mkdir -p /var/lib/nsrrsetd
    chown nsrrsetd:nsrrsetd /var/lib/nsrrsetd
    chmod 750 /var/lib/nsrrsetd
fi</script>
              </preinstallScriptlet>
              <postinstallScriptlet>
                <script># Reload systemd daemon to pick up new unit file
systemctl daemon-reload || true

# Print usage information
echo "========================================="
echo "nsrrsetd installed successfully!"
echo ""
echo "To start an instance for a DNS recursor:"
echo "  systemctl start nsrrsetd@RECURSOR_IP"
echo ""
echo "Examples:"
echo "  systemctl start nsrrsetd@8.8.8.8"
echo "  systemctl start nsrrsetd@192.168.1.1"
echo ""
echo "Enable on boot:"
echo "  systemctl enable nsrrsetd@8.8.8.8"
echo ""
echo "Configuration: /etc/sysconfig/nsrrsetd"
echo "Documentation: /opt/nsrrsetd/docs/"
echo "========================================="</script>
              </postinstallScriptlet>
              <postremoveScriptlet>
                <script># Reload systemd daemon after unit file removal
systemctl daemon-reload || true</script>
              </postremoveScriptlet>
              <entries>
                <entry>
                  <name>/usr/lib/systemd/system/nsrrsetd@.service</name>
                  <file>src/main/systemd/nsrrsetd@.service</file>
                  <user>root</user>
                  <group>root</group>
                  <mode>0444</mode>
                </entry>
                <entry>
                  <name>/etc/sysconfig/nsrrsetd</name>
                  <file>src/main/sysconfig/nsrrsetd</file>
                  <user>root</user>
                  <group>root</group>
                  <mode>0644</mode>
                  <configuration>noreplace</configuration>
                </entry>
                <entry>
                  <name>/opt/nsrrsetd/nsrrsetd.jar</name>
                  <file>target/nsrrsetd-${project.version}-jar-with-dependencies.jar</file>
                  <user>root</user>
                  <group>root</group>
                  <mode>0444</mode>
                </entry>
                <entry>
                  <name>/opt/nsrrsetd/docs/INSTALL.md</name>
                  <file>src/main/sysconfig/INSTALL.md</file>
                  <user>root</user>
                  <group>root</group>
                  <mode>0444</mode>
                  <documentation>true</documentation>
                </entry>
                <entry>
                  <name>/opt/nsrrsetd/docs/PORT80-SETUP.md</name>
                  <file>src/main/sysconfig/PORT80-SETUP.md</file>
                  <user>root</user>
                  <group>root</group>
                  <mode>0444</mode>
                  <documentation>true</documentation>
                </entry>
                <entry>
                  <name>/opt/nsrrsetd/docs/README-INSTANCES.md</name>
                  <file>src/main/sysconfig/README-INSTANCES.md</file>
                  <user>root</user>
                  <group>root</group>
                  <mode>0444</mode>
                  <documentation>true</documentation>
                </entry>
                <entry>
                  <name>/var/lib/nsrrsetd</name>
                  <directory>true</directory>
                  <user>nsrrsetd</user>
                  <group>nsrrsetd</group>
                  <mode>0750</mode>
                </entry>
              </entries>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.target>25</maven.compiler.target>
    <maven.compiler.source>25</maven.compiler.source>
  </properties>
</project>
